# Ollama OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Model tag. "ledgerlens" is built from ./Modelfile (see README). Any `ollama list` tag works.
OLLAMA_MODEL=ledgerlens
# SQLite/LibSQL file for Mastra storage
MASTRA_DATABASE_URL=file:./ledgerlens.db
# Set RAG=off to run the no-retrieval baseline for evaluation
RAG=on
# Number of evidence chunks per call (lower = faster on small machines)
RAG_TOP_K=4

# Speed / FAST mode (1 = fewer items, terse fields; use with Modelfile.fast)
FAST=0
# NOCACHE=1 disables the on-disk result cache
